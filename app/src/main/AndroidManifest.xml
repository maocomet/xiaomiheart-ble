<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- HTTPS POST of each reading to the wearable receiver. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 11 and below: scanning required location permission, and the old
        BLUETOOTH/BLUETOOTH_ADMIN pair. maxSdkVersion keeps them off 12+.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
        Android 12+: neverForLocation is a deliberate assertion that this app does
        not derive physical location from scan results, which keeps location
        permission out of the picture entirely.

        If the band turns out not to show up in scans, the documented fallback is to
        drop neverForLocation and request ACCESS_FINE_LOCATION on 12+ as well.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Monitoring has to survive the Activity going away, so it runs in a foreground
        service of type connectedDevice. On Android 14 (API 34) that type is mandatory:
        startForeground() throws MissingForegroundServiceTypeException without it.

        FOREGROUND_SERVICE_CONNECTED_DEVICE is the API 34 runtime prerequisite; it is
        satisfied because the app also holds BLUETOOTH_SCAN and BLUETOOTH_CONNECT.

        POST_NOTIFICATIONS is requested at runtime on 13+. Being denied it does not stop
        the service - it only makes the notification invisible - so a refusal is not
        treated as a failure to start.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="HR BLE PoC"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            stopWithTask="false" is the default and is set explicitly because it is the
            whole point: swiping the app out of the recents list must not stop the
            service. onTaskRemoved() is deliberately not implemented for the same
            reason - there is nothing to clean up, the BLE link outlives the task.
        -->
        <service
            android:name=".HrMonitorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
